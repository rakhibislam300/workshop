NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Used only by protected server-side AI routes. Never expose this as NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional email reminder worker. Keep every value server-only; do not prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Jibon AI <reminders@example.com>"
REMINDER_WORKER_SECRET=
# Optional household invitation/profile-claim delivery worker. Set APP_URL to
# the local or deployed origin used in the email link; never expose this secret.
APP_URL=http://localhost:3000
COLLABORATION_EMAIL_WORKER_SECRET=
# Optional asynchronous Document Intelligence worker. These remain server-only.
# The worker sends a source file to the configured OpenAI model only when invoked.
DOCUMENT_INTELLIGENCE_WORKER_SECRET=
